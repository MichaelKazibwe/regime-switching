ARG PYTHON_BASE_IMAGE=python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${PYTHON_BASE_IMAGE} AS build

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_CACHE_HOME=/tmp/product-cache
WORKDIR /app
COPY requirements-paper.hashed.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-paper.hashed.lock \
    && python -m pip check
# Build only from the allowlisted product_build.py staging context.
# Compilers and package managers remain in the build stage only.
COPY deploy/runtime/build_sqlite.py ./deploy/runtime/build_sqlite.py
RUN apt-get update && apt-get install --no-install-recommends -y gcc make libc6-dev zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN python deploy/runtime/build_sqlite.py
RUN apt-get update && apt-get install --no-install-recommends -y perl patch && rm -rf /var/lib/apt/lists/*
COPY deploy/runtime/build_openssl.py deploy/runtime/verify_native_tls.py ./deploy/runtime/
RUN python deploy/runtime/build_openssl.py
COPY deploy/runtime/ ./deploy/runtime/
RUN python deploy/runtime/collect_runtime.py && python -c 'import sqlite3; assert sqlite3.sqlite_version=="3.54.1"'

COPY *.py ./
COPY release-manifest.json Dockerfile.recommendations .dockerignore ./
COPY research/ ./research/
COPY dashboard/investor.html dashboard/investor.css dashboard/investor.js ./dashboard/
RUN mkdir -p /app/var && chown -R 10001:10001 /app


FROM gcr.io/distroless/base-nossl-debian13:nonroot@sha256:4006ac92504be607b70de01d1f64f38288c69fcd8faa820f6d3aed266ea32ac5
COPY --from=build /runtime/ /
COPY --from=build /app/ /app/
ENV PATH=/usr/local/bin LD_LIBRARY_PATH=/usr/local/lib PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp XDG_CACHE_HOME=/tmp/regime-cache
WORKDIR /app
USER 10001:10001
# A private batch recommendation/report job. No port or order worker is started.
ENTRYPOINT ["python", "-m", "investment_product"]
CMD ["--help"]
