ARG PYTHON_BASE_IMAGE=python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_CACHE_HOME=/tmp/product-cache
WORKDIR /app
COPY requirements-paper.hashed.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-paper.hashed.lock \
    && python -m pip check
# Build only from the allowlisted product_build.py staging context.
COPY *.py ./
COPY release-manifest.json Dockerfile.recommendations .dockerignore ./
COPY research/ ./research/
COPY dashboard/investor.html dashboard/investor.css dashboard/investor.js ./dashboard/
RUN mkdir -p /app/var && chown -R 10001:10001 /app
USER 10001:10001
# A private batch recommendation/report job. No port or order worker is started.
ENTRYPOINT ["python", "-m", "investment_product"]
CMD ["--help"]
