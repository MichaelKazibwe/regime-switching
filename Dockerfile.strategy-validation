COPY requirements-paper.hashed.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-paper.hashed.lock && python -m pip check
# Compilers and package managers remain in the build stage only.
COPY deploy/runtime/ ./deploy/runtime/
RUN apt-get update && apt-get install --no-install-recommends -y gcc make libc6-dev zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN python deploy/runtime/build_sqlite.py && python deploy/runtime/collect_runtime.py && python -c 'import sqlite3; assert sqlite3.sqlite_version=="3.54.1"'

