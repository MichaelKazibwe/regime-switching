# Copy into the deployment secret/configuration store. Do not commit a filled
# .env file. Only this paper configuration is supported by paper_service.py.
TRADING_MODE=PAPER
# Set in the host environment or Compose's protected .env interpolation file.
# PAPER_IMAGE must identify the reviewed image (sha256 ID or registry digest).
LIVE_TRADING_ENABLED=false
BROKER_SUBMISSION_ENABLED=false
FRED_API_KEY=inject-through-secret-manager

PAPER_STATE_DATABASE=var/paper-state.sqlite3
PAPER_AUDIT_LOG=var/paper-audit.jsonl
PAPER_REPORT_DIRECTORY=var/paper-reports
PAPER_DASHBOARD_FILE=var/paper-dashboard.html
PAPER_RESEARCH_SNAPSHOT_DIRECTORY=var/research-snapshots
PAPER_ALERT_FILE=var/paper-alerts.jsonl
PAPER_INITIAL_CASH=1000000
PAPER_CASH_BUFFER_FRACTION=0.01
PAPER_COMMISSION_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.001

# Optional SMTP alert delivery. Configure all required fields together.
# Inject the password from a secret manager; do not store it in this file.
PAPER_SMTP_HOST=
PAPER_SMTP_PORT=587
PAPER_SMTP_SENDER=
PAPER_ALERT_RECIPIENT=
PAPER_SMTP_USERNAME=
PAPER_SMTP_PASSWORD=
PAPER_SMTP_USE_TLS=true
PAPER_MONTHLY_RECIPIENTS_FILE=/app/.env.monthly-recipients.json

MARKET_DATA_PERIOD=15y
MAXIMUM_PRICE_AGE_HOURS=72
REBALANCE_INTERVAL_DAYS=21
TRADING_TIMEZONE=America/New_York
BENCHMARK=SPY
