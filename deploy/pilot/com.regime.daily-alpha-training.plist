<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.regime.daily-alpha-training</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__PROJECT_ROOT__/daily_alpha_training.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/var/daily-alpha-training/launchd.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/var/daily-alpha-training/launchd.stdout.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
</dict>
</plist>
