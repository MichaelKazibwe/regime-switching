ARG PYTHON_BASE_IMAGE=python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${PYTHON_BASE_IMAGE} AS build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_CACHE_HOME=/tmp/regime-cache
WORKDIR /app
# Pin the available Debian security fix; do not silently relax unresolved findings.
ARG ZLIB_SECURITY_VERSION=1:1.3.dfsg+really1.3.1-1+deb13u1
RUN apt-get update && apt-get install --no-install-recommends -y zlib1g=${ZLIB_SECURITY_VERSION} && rm -rf /var/lib/apt/lists/*
COPY requirements-paper.hashed.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-paper.hashed.lock && python -m pip check
# Compilers and package managers remain in the build stage only.
COPY deploy/runtime/ ./deploy/runtime/
RUN apt-get update && apt-get install --no-install-recommends -y gcc make libc6-dev zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN python deploy/runtime/build_sqlite.py && python deploy/runtime/collect_runtime.py && python -c 'import sqlite3; assert sqlite3.sqlite_version=="3.54.1"'

COPY Dockerfile.pilot .dockerignore ./
COPY *.py pilot-release.json ./
COPY dashboard/ ./dashboard/
COPY pilot/ ./pilot/
COPY research/ ./research/
RUN mkdir -p /app/var/pilot /app/output && chown -R 10001:10001 /app


FROM gcr.io/distroless/cc-debian13:nonroot@sha256:cb87acc574abe719b6e5c547384defa2f7b1f24af9605d3f618cf852495d8be2
COPY --from=build /runtime/ /
COPY --from=build /app/ /app/
ENV PATH=/usr/local/bin LD_LIBRARY_PATH=/usr/local/lib PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp XDG_CACHE_HOME=/tmp/regime-cache
WORKDIR /app
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD ["python", "-c", "import os,urllib.request,urllib.parse; r=urllib.request.Request('http://127.0.0.1:8780/healthz', headers={'Host':urllib.parse.urlsplit(os.environ['PILOT_PUBLIC_ORIGIN']).netloc}); urllib.request.urlopen(r,timeout=4).read()"]
ENTRYPOINT ["python", "pilot_server.py"]
CMD ["--snapshot", "var/pilot-input/launch.json", "--bind", "0.0.0.0", "--benchmark", "var/pilot-input/benchmark.json"]
